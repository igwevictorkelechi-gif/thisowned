# Copy this file to `.env` and fill in real values for local development.
# In production (Vercel), set these in Project Settings -> Environment Variables.
# NEVER commit the real `.env` file — it is gitignored.

# --- Django core ---
DJANGO_SECRET_KEY=generate-a-new-50-char-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=*

# --- Database (Neon / PostgreSQL) ---
# If DB_HOST/DB_PASSWORD are unset, the app falls back to a local SQLite file.
DB_NAME=verceldb
DB_USER=default
DB_PASSWORD=your-new-rotated-db-password
DB_HOST=your-neon-host.aws.neon.tech
DB_PORT=5432

# --- Supabase storage ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-new-rotated-supabase-key
SUPABASE_BUCKET_NAME=thisowned-eco

# --- JWT (defaults to DJANGO_SECRET_KEY if unset) ---
JWT_SIGNING_KEY=generate-another-random-secret
